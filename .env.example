# CampusLoop 3.0 Development Environment Variables
# Targets development project 'campusloop-dev' (NEVER use production credentials here)
#
# Obtain these values from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (Publishable / Anon)

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co

# Supabase Publishable Public Key (Standard format; safe to use in browser; protected by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Anon Public Key (Legacy fallback alias; safe to use in browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SECURITY NOTICE:
# NEVER place a Supabase secret, service-role administrative key, database password,
# or backend credential in client code, in any VITE_ variable, or in any committed repository file.
