# CampusLoop 3.0 Development Environment Variables
# Targets development project 'campusloop-dev' (NEVER use production credentials here)
#
# Obtain these values from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co

# Supabase Anon Public Key (Safe to use in the browser; protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: Never add service_role keys or secrets here or in any client-facing code.
